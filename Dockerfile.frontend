FROM node:22-alpine

WORKDIR /app
COPY frontend/package.json frontend/tsconfig.json frontend/build.mjs ./
COPY frontend/src ./src
COPY frontend/public ./public

RUN npm install -g esbuild typescript && esbuild src/main.tsx --bundle --outfile=public/bundle.js --format=iife --target=es2020 --jsx-factory=h --jsx-fragment=Fragment

EXPOSE 3000
CMD ["npx", "serve", "-s", "public", "-l", "3000"]

