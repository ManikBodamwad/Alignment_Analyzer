# =============================================================================
# Stakeholder–Structure Alignment Analyzer - Environment Configuration Template
# =============================================================================

# Database Configuration
# For Docker / Production PostgreSQL with pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alignment_analyzer
# For Local Standalone Execution (default if unset):
DATABASE_URL=sqlite:///./alignment_analyzer.db

# LLM Provider Configuration ("openai", "anthropic", "gemini", or "evidence_engine")
# If no API key is set, the system automatically uses the deterministic
# Evidence-Grounded Diagnostic Engine that strictly extracts and cites uploaded documents.
LLM_PROVIDER=evidence_engine
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding Provider Configuration ("openai" or "hybrid_vector")
EMBEDDING_PROVIDER=hybrid_vector
EMBEDDING_DIMENSION=384

# Security & Access Control
APP_SECRET_KEY=change-this-secret-key-in-production
DEFAULT_USER_NAME=Lead Organizational Analyst
DEFAULT_USER_ROLE=Admin
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./storage/uploads

